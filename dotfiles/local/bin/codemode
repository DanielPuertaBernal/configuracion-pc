#!/usr/bin/env bash
# codemode: Stark-style boot sequence — plays "Back in Black" on Spotify, hides Spotify
# in the Super+S scratchpad and launches herdr.
# Set CODEMODE_DRY_RUN=1 to print the actions without executing them.
set -uo pipefail

TRACK_URI="spotify:track:08mG3Y1vljYA6bvDt4Wqkj" # AC/DC — Back In Black
MPRIS_DEST="org.mpris.MediaPlayer2.spotify"
SCRATCHPAD="special:scratchpad"
DRY_RUN="${CODEMODE_DRY_RUN:-0}"

red=$'\e[1;31m'; gold=$'\e[1;33m'; cyan=$'\e[1;36m'; dim=$'\e[2m'; reset=$'\e[0m'

run() {
  if [[ "$DRY_RUN" == "1" ]]; then
    echo "${dim}[dry-run] $*${reset}"
  else
    "$@"
  fi
}

say() {
  printf '%s\n' "${cyan}J.A.R.V.I.S.${reset} ${dim}›${reset} $1"
  [[ "$DRY_RUN" == "1" ]] || sleep "${2:-0.4}"
}

spotify_running() {
  dbus-send --session --print-reply --dest=org.freedesktop.DBus /org/freedesktop/DBus \
    org.freedesktop.DBus.ListNames 2>/dev/null | grep -q "$MPRIS_DEST"
}

spotify_window_exists() {
  hyprctl clients -j 2>/dev/null | grep -q '"class": "spotify"'
}

play_track() {
  if spotify_running; then
    run dbus-send --session --type=method_call --dest="$MPRIS_DEST" /org/mpris/MediaPlayer2 \
      org.mpris.MediaPlayer2.Player.OpenUri "string:$TRACK_URI"
  else
    run setsid -f spotify --uri="$TRACK_URI" >/dev/null 2>&1
  fi
}

hide_spotify() {
  # A freshly launched Spotify needs a moment to map its window.
  if [[ "$DRY_RUN" != "1" ]]; then
    for _ in {1..30}; do
      spotify_window_exists && break
      sleep 0.5
    done
  fi
  run hyprctl dispatch \
    "hl.dsp.window.move({ workspace = \"$SCRATCHPAD\", follow = false, window = \"class:^(spotify)\$\" })" \
    >/dev/null

  # Spotify requests activation when it receives the track (focus_on_activate is on),
  # which opens the scratchpad. Wait for that, then close it so only herdr stays visible.
  [[ "$DRY_RUN" == "1" ]] || sleep 1.5
  if hyprctl monitors -j 2>/dev/null | grep -q "\"name\": \"$SCRATCHPAD\""; then
    run hyprctl dispatch 'hl.dsp.workspace.toggle_special("scratchpad")' >/dev/null
  fi
}

clear
printf '%s' "${red}"
cat <<'BANNER'
   ██████╗  █████╗ ███╗   ██╗███████╗ ██████╗
   ██╔══██╗██╔══██╗████╗  ██║██╔════╝██╔═══██╗
   ██║  ██║███████║██╔██╗ ██║███████╗██║   ██║
   ██║  ██║██╔══██║██║╚██╗██║╚════██║██║   ██║
   ██████╔╝██║  ██║██║ ╚████║███████║╚██████╔╝
   ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═══╝╚══════╝ ╚═════╝
BANNER
printf '%s\n\n' "${gold}        I N D U S T R I E S  ·  C O D E   M O D E${reset}"

say "Buenas, señor Daniel. Iniciando el modo código."
say "Reactor Arc al 100%. Todos los sistemas en línea."
say "Poniendo su banda sonora: AC/DC, Back in Black."
play_track
hide_spotify
run notify-send -a "J.A.R.V.I.S." "Modo código activado" "Back in Black sonando, señor Daniel. A construir algo."

if [[ "${HERDR_ENV:-}" == "1" ]]; then
  say "Ya está dentro de herdr, señor Daniel. El taller está listo." 0
  exit 0
fi

say "Desplegando el taller: herdr." 0.6
if [[ "$DRY_RUN" == "1" ]]; then
  echo "${dim}[dry-run] exec herdr${reset}"
else
  exec herdr
fi
