#!/usr/bin/env bash
# Restart waynergy after resume: its TCP connection goes stale during suspend.
gdbus monitor --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1 |
  while read -r line; do
    if [[ "$line" == *"PrepareForSleep (false"* ]]; then
      sleep 2
      systemctl --user restart waynergy.service
    fi
  done
